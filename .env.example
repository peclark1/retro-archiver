# Retro Archiver local configuration

# Stable ArchiveBox image by default.
ARCHIVEBOX_IMAGE=archivebox/archivebox:latest

# Web UI port on the SIMH host.
ARCHIVEBOX_PORT=8000

# Phase 1: leave this as ./archive for local testing.
# Phase 2 example:
# ARCHIVE_ROOT=/mnt/retro-archive/archivebox/archive
ARCHIVE_ROOT=./archive

# Safety limits for the initial proof of concept.
CRAWL_MAX_URLS=250
MEDIA_MAX_SIZE=750m
