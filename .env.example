# Retro Archiver local configuration

# Pin the current stable ArchiveBox release for reproducible captures.
# v0.9.x is still prerelease as of August 2026.
ARCHIVEBOX_IMAGE=archivebox/archivebox:0.7.4

# Web UI port on the SIMH host.
ARCHIVEBOX_PORT=8000

# Phase 1: leave this as ./archive for local testing.
# Phase 2 example:
# ARCHIVE_ROOT=/mnt/retro-archive/archivebox/archive
ARCHIVE_ROOT=./archive

# Safety limits for the initial proof of concept.
CRAWL_MAX_URLS=250
MEDIA_MAX_SIZE=750m

# Local-first preservation policy. ArchiveBox normally submits every captured
# URL to archive.org as an additional copy; Retro Archiver disables that by
# default. Set True explicitly later if a collection should also be submitted
# to the Wayback Machine.
SAVE_ARCHIVE_DOT_ORG=False
